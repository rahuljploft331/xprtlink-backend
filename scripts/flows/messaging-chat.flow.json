    {
      "name": "Step 11: Verify Message History",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('messages returned', function () {",
              "  var items = json.data.items || json.data;",
              "  pm.expect(items).to.be.an('array');",
              "  pm.expect(items.length).to.be.at.least(3);",
              "});",
              "pm.test('conversation has messages from both parties', function () {",
              "  var items = json.data.items || json.data;",
              "  var bodies = items.map(function(m) { return m.body; }).join(' ');",
              "  pm.expect(bodies).to.include('Hello');",
              "  pm.expect(bodies).to.include('available');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
