    {
      "name": "Step 5: Get Expert Profile ID",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var ts = Date.now();",
              "// Complete minimal onboarding so expert profile exists",
              "pm.sendRequest({",
              "  url: pm.collectionVariables.get('base_url') + '/api/v1/experts/me/onboarding',",
              "  method: 'POST',",
              "  header: [",
              "    { key: 'Authorization', value: 'Bearer ' + pm.collectionVariables.get('expert_token') },",
              "    { key: 'Content-Type', value: 'application/json' }",
              "  ],",
              "  body: { mode: 'raw', raw: JSON.stringify({ bio: 'Messaging flow expert.', headline: 'Chat Specialist', hourlyRate: 80, experienceYears: 3 }) }",
              "}, function () {});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('expert id present', function () { pm.expect(json.data.id).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('expert_id', json.data.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
