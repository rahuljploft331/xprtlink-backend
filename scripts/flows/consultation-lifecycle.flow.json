    {
      "name": "Step 3: Add Customer Payment Method",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var ts = Date.now();",
              "// Generate a unique PM ID to avoid unique constraint conflicts",
              "pm.collectionVariables.set('stripe_pm_id', 'pm_card_visa_' + ts);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "var json = pm.response.json();",
              "pm.test('payment method created', function () { pm.expect(json.success).to.be.true; });",
              "if (json.data && json.data.id) { pm.collectionVariables.set('payment_method_id', json.data.id); }"
            ],
            "type": "text/javascript"
          }
