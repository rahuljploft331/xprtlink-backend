    {
      "name": "Admin Approves Expert Verification (Consult Flow)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. Login as admin",
              "pm.sendRequest({",
              "  url: pm.collectionVariables.get(\"base_url\") + \"/api/v1/admin/auth/login\",",
              "  method: \"POST\",",
              "  header: [{ key: \"Content-Type\", value: \"application/json\" }],",
              "  body: { mode: \"raw\", raw: JSON.stringify({ email: \"admin@xpertlink.com\", password: \"Admin@123\" }) }",
              "}, function (err, loginRes) {",
              "  var loginJson = loginRes.json();",
              "  var adminToken = (loginJson.data && loginJson.data.accessToken) ? loginJson.data.accessToken : \"\";",
              "  pm.collectionVariables.set(\"admin_token\", adminToken);",
              "  // 2. Fetch pending verifications",
              "  pm.sendRequest({",
              "    url: pm.collectionVariables.get(\"base_url\") + \"/api/v1/admin/verifications?status=pending\",",
              "    method: \"GET\",",
              "    header: [{ key: \"Authorization\", value: \"Bearer \" + adminToken }]",
              "  }, function (err2, listRes) {",
              "    var list = listRes.json();",
              "    var expertId = pm.collectionVariables.get(\"expert_id\");",
              "    // list item shape: { id, expert: { id, ... }, status, ... }",
              "    var items = (list.data && list.data.items) ? list.data.items : [];",
              "    var verif = items.find(function(v) { return v.expert && v.expert.id === expertId; });",
              "    if (verif) {",
              "      pm.collectionVariables.set(\"verif_id\", verif.id);",
              "    }",
              "  });",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expert approved 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
