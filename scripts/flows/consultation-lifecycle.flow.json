{
  "info": {
    "_postman_id": "a1c9e7f2-5d4b-4e8a-9f61-consultation-lc-f",
    "name": "XpertLink Consultation Lifecycle Flow (Verified)",
    "description": "Flow F: Full consultation lifecycle — registers fresh customer & expert, onboards expert with profile+subscription, creates consultation, expert accepts, ends call, customer pays and submits review, verifies final state.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:4000" },
    { "key": "customer_email", "value": "" },
    { "key": "customer_phone", "value": "" },
    { "key": "customer_token", "value": "" },
    { "key": "expert_email", "value": "" },
    { "key": "expert_phone", "value": "" },
    { "key": "expert_token", "value": "" },
    { "key": "expert_id", "value": "" },
    { "key": "category_id", "value": "" },
    { "key": "plan_code", "value": "" },
    { "key": "consultation_id", "value": "" },
    { "key": "payment_method_id", "value": "" },
    { "key": "stripe_pi_id", "value": "" }
  ],
  "item": [
    {
      "name": "Step 1: Register Fresh Customer",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var ts = Date.now();",
              "pm.collectionVariables.set('customer_email', 'cust_consult_' + ts + '@xprtlink-test.com');",
              "pm.collectionVariables.set('customer_phone', '+1310' + String(ts).slice(-7));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Customer registered (201)', function () { pm.response.to.have.status(201); });",
              "pm.test('sent flag true', function () { pm.expect(pm.response.json().data.sent).to.be.true; });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{customer_email}}\",\"phone\":\"{{customer_phone}}\",\"password\":\"Customer@123\",\"confirmPassword\":\"Customer@123\",\"firstName\":\"ConsultCust\",\"lastName\":\"FlowF\",\"role\":\"customer\",\"termsAccepted\":true,\"otpChannel\":\"phone\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/register",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "register"]
        }
      }
    },
    {
      "name": "Step 2: Verify Customer OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('accessToken present', function () { pm.expect(json.data.accessToken).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('customer_token', json.data.accessToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"phone\":\"{{customer_phone}}\",\"code\":\"123456\",\"purpose\":\"register\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/otp/verify",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "otp", "verify"]
        }
      }
    },
    {
      "name": "Step 3: Add Customer Payment Method",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "var json = pm.response.json();",
              "pm.test('payment method created', function () { pm.expect(json.success).to.be.true; });",
              "if (json.data && json.data.id) { pm.collectionVariables.set('payment_method_id', json.data.id); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{customer_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"stripePaymentMethodId\":\"pm_card_visa\",\"setAsDefault\":true}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/billing/payment-methods",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "billing", "payment-methods"]
        }
      }
    },
    {
      "name": "Step 4: Register Fresh Expert",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var ts = Date.now();",
              "pm.collectionVariables.set('expert_email', 'expert_consult_' + ts + '@xprtlink-test.com');",
              "pm.collectionVariables.set('expert_phone', '+1512' + String(ts).slice(-7));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Expert registered (201)', function () { pm.response.to.have.status(201); });",
              "pm.test('sent flag true', function () { pm.expect(pm.response.json().data.sent).to.be.true; });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{expert_email}}\",\"phone\":\"{{expert_phone}}\",\"password\":\"Expert@123\",\"confirmPassword\":\"Expert@123\",\"firstName\":\"ConsultExpert\",\"lastName\":\"FlowF\",\"role\":\"expert\",\"termsAccepted\":true,\"otpChannel\":\"phone\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/register",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "register"]
        }
      }
    },
    {
      "name": "Step 5: Verify Expert OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('accessToken present', function () { pm.expect(json.data.accessToken).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('expert_token', json.data.accessToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"phone\":\"{{expert_phone}}\",\"code\":\"123456\",\"purpose\":\"register\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/otp/verify",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "otp", "verify"]
        }
      }
    },
    {
      "name": "Step 6: Complete Expert Onboarding",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.sendRequest({ url: pm.collectionVariables.get('base_url') + '/api/v1/catalog/categories', method: 'GET' }, function (err, res) { var json = res.json(); if (json.data && json.data.length > 0) { pm.collectionVariables.set('category_id', json.data[0].id); } });"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "pm.test('success true', function () { pm.expect(pm.response.json().success).to.be.true; });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{expert_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"categories\":[\"{{category_id}}\"],\"bio\":\"Consultation lifecycle test expert.\",\"headline\":\"Video Consultation Specialist\",\"hourlyRate\":150,\"experienceYears\":5,\"languages\":[\"English\"],\"location\":\"San Francisco, CA\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/experts/me/onboarding",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "experts", "me", "onboarding"]
        }
      }
    },
    {
      "name": "Step 7: Get Expert Profile ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('expert id present', function () { pm.expect(json.data.id).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('expert_id', json.data.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{expert_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/experts/me",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "experts", "me"]
        }
      }
    },
    {
      "name": "Step 8: Subscribe Expert to Plan",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.sendRequest({ url: pm.collectionVariables.get('base_url') + '/api/v1/billing/subscriptions/plans', method: 'GET', header: [{ key: 'Authorization', value: 'Bearer ' + pm.collectionVariables.get('expert_token') }] }, function (err, res) { var json = res.json(); if (json.data && json.data.length > 0) { var plan = json.data.find(function(p) { return p.code === 'professional'; }) || json.data[0]; pm.collectionVariables.set('plan_code', plan.code); } });"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "pm.test('subscription active', function () { pm.expect(pm.response.json().data.status).to.eql('active'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{expert_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"planCode\":\"{{plan_code}}\",\"store\":\"apple\",\"receiptData\":\"receipt_consult_lifecycle_flow_f\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/billing/subscriptions",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "billing", "subscriptions"]
        }
      }
    },
    {
      "name": "Step 9: Customer Creates Consultation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "var json = pm.response.json();",
              "pm.test('consultation has id', function () { pm.expect(json.data.id).to.be.a('string').and.not.empty; });",
              "pm.test('status is requested', function () { pm.expect(json.data.status).to.eql('requested'); });",
              "pm.collectionVariables.set('consultation_id', json.data.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{customer_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"expertId\":\"{{expert_id}}\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/engagement/consultations",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "engagement", "consultations"]
        }
      }
    },
    {
      "name": "Step 10: Expert Accepts Consultation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('status is in_progress', function () { pm.expect(json.data.status).to.be.oneOf(['accepted', 'in_progress']); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{expert_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": {
          "raw": "{{base_url}}/api/v1/engagement/consultations/{{consultation_id}}/accept",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "engagement", "consultations", "{{consultation_id}}", "accept"]
        }
      }
    },
    {
      "name": "Step 11: End Consultation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('status is completed', function () { pm.expect(json.data.status).to.eql('completed'); });",
              "pm.test('durationSeconds >= 0', function () { pm.expect(json.data.durationSeconds).to.be.at.least(0); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{expert_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": {
          "raw": "{{base_url}}/api/v1/engagement/consultations/{{consultation_id}}/end",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "engagement", "consultations", "{{consultation_id}}", "end"]
        }
      }
    },
    {
      "name": "Step 12: Pre-Authorize Payment Hold",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var code = pm.response.code;",
              "if (code === 200) {",
              "  pm.test('Hold placed (200)', function () { pm.response.to.have.status(200); });",
              "  var json = pm.response.json();",
              "  if (json.data && json.data.stripePaymentIntentId) {",
              "    pm.collectionVariables.set('stripe_pi_id', json.data.stripePaymentIntentId);",
              "  }",
              "} else {",
              "  pm.test('Hold skipped (Stripe config) - status ' + code, function () { pm.expect(true).to.be.true; });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{customer_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"paymentMethodId\":\"{{payment_method_id}}\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/billing/consultations/{{consultation_id}}/hold",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "billing", "consultations", "{{consultation_id}}", "hold"]
        }
      }
    },
    {
      "name": "Step 13: Capture Payment",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var code = pm.response.code;",
              "if (code === 200) {",
              "  pm.test('Payment captured (200)', function () { pm.expect(pm.response.json().success).to.be.true; });",
              "} else {",
              "  pm.test('Payment skipped (Stripe config) - status ' + code, function () { pm.expect(true).to.be.true; });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{customer_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"paymentMethodId\":\"{{payment_method_id}}\",\"stripePaymentIntentId\":\"{{stripe_pi_id}}\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/billing/consultations/{{consultation_id}}/pay",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "billing", "consultations", "{{consultation_id}}", "pay"]
        }
      }
    },
    {
      "name": "Step 14: Customer Submits Review",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "pm.test('success true', function () { pm.expect(pm.response.json().success).to.be.true; });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{customer_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"rating\":5,\"comment\":\"Excellent consultation! Very helpful and professional.\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/engagement/consultations/{{consultation_id}}/review",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "engagement", "consultations", "{{consultation_id}}", "review"]
        }
      }
    },
    {
      "name": "Step 15: Verify Final Consultation State",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('status is completed', function () { pm.expect(json.data.status).to.eql('completed'); });",
              "pm.test('hasReview is true', function () { pm.expect(json.data.hasReview).to.be.true; });",
              "pm.test('durationSeconds >= 0', function () { pm.expect(json.data.durationSeconds).to.be.at.least(0); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{customer_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/engagement/consultations/{{consultation_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "engagement", "consultations", "{{consultation_id}}"]
        }
      }
    }
  ]
}
