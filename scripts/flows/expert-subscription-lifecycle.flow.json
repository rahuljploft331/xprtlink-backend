    {
      "name": "Step 11: Schedule Cancellation (Cancel at Period End)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('cancelAtPeriodEnd is true', function () {",
              "  pm.expect(json.data.cancelAtPeriodEnd || json.data.status).to.satisfy(function(v) {",
              "    return v === true || v === 'active' || v === 'cancelling';",
              "  });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
