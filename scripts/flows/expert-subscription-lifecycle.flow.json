          ]
        }
      }
    },
    {
      "name": "Step 10: Upgrade Plan (professional \u2192 elite)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "var json = pm.response.json();",
              "pm.test('Subscription still active after upgrade', function () { pm.expect(json.data.status).to.eql('active'); });",
              "pm.test('Plan upgraded to elite', function () {",
              "  pm.expect(json.data.plan.code || json.data.planCode || '').to.satisfy(function(v) { return v === pm.collectionVariables.get('upgrade_plan_code') || v === 'elite'; });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
