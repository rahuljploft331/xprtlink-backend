          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"phone\":\"{{fresh_phone}}\",\"code\":\"123456\",\"purpose\":\"verify_phone\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/otp/verify",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "otp",
            "verify"
          ]
        }
      }
    },
