    {
      "name": "Step 5: List Subscription Plans",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('Plans list non-empty', function () { pm.expect(json.data).to.be.an('array').that.is.not.empty; });",
              "var pro = json.data.find(function(p) { return p.code === 'professional'; }) || json.data[0];",
              "pm.collectionVariables.set('plan_code', pro.code);",
              "pm.collectionVariables.set('plan_id', pro.id);",
              "var elite = json.data.find(function(p) { return p.code === 'elite'; }) || json.data[json.data.length - 1];",
              "pm.collectionVariables.set('upgrade_plan_code', elite.code);",
              "pm.collectionVariables.set('upgrade_plan_id', elite.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{expert_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/billing/subscriptions/plans",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "billing",
            "subscriptions",
            "plans"
          ]
        }
      }
    },
    {
      "name": "Step 6: Subscribe to Plan (First Time)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "var json = pm.response.json();",
              "pm.test('Subscription is active', function () { pm.expect(json.data.status).to.eql('active'); });",
              "if (json.data && json.data.id) { pm.collectionVariables.set('subscription_id', json.data.id); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
