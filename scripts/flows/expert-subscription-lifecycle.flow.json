      "name": "Step 0b: Verify Phone OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('verified is true', function () { pm.expect(json.data.verified).to.be.true; });"
            ],
