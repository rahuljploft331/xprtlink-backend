        "body": {
          "mode": "raw",
          "raw": "{\"categoryIds\":[\"{{category_id}}\"],\"bio\":\"Seasoned professional with extensive industry experience. Email-onboarded init flow account.\",\"headline\":\"Industry Expert\",\"title\":\"Senior Consultant\",\"businessName\":\"XpertLink Consulting LLC\",\"consultationRate\":150,\"experienceYears\":10,\"languages\":[\"English\",\"Spanish\"],\"serviceAreas\":[{\"name\":\"San Francisco, CA\",\"lat\":37.7749,\"lng\":-122.4194}],\"avatarMediaId\":\"{{avatar_media_id}}\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/experts/me/onboarding/submit",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "experts",
            "me",
            "onboarding",
            "submit"
          ]
        }
      }
