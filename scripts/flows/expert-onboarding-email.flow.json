              "pm.test('Approve 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('success true', function () { pm.expect(json.success).to.be.true; });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"notes\":\"Auto-approved by expert onboarding flow B\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/admin/verifications/{{verification_id}}/approve",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "verifications",
            "{{verification_id}}",
            "approve"
          ]
        }
      }
    },
    {
      "name": "Step 4d: Confirm Expert Is Approved & Search Eligible",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Expert profile 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('verificationStatus is approved', function () { pm.expect(json.data.verificationStatus).to.eql('approved'); });"
