    {
      "name": "Step 3: Complete Expert Profile",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Always re-resolve category_id from THIS base_url. Never reuse a stale value —",
              "// a category UUID from another environment causes FOREIGN_KEY_VIOLATION on submit.",
              "pm.collectionVariables.unset('category_id');",
              "pm.sendRequest({",
              "  url: pm.variables.get('base_url') + '/api/v1/catalog/categories',",
              "  method: 'GET'",
              "}, function (err, res) {",
              "  if (err) { console.error('category lookup failed:', err); return; }",
              "  var json = res.json();",
              "  var list = (json && json.data) ? json.data : [];",
              "  if (list.length > 1) {",
              "    pm.collectionVariables.set('category_id', list[1].id);",
              "  } else if (list.length > 0) {",
              "    pm.collectionVariables.set('category_id', list[0].id);",
              "  }",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// If this fails with FOREIGN_KEY_VIOLATION, category_id points at a row that does not",
              "// exist in the target DB (usually a stale value from another environment).",
              "if (pm.response.code === 400 || pm.response.code === 406) {",
              "  var body = pm.response.json();",
              "  if (body && body.code === 'FOREIGN_KEY_VIOLATION') {",
              "    pm.test('FAILED: category_id not valid for this environment (' + pm.collectionVariables.get('category_id') + ')', function () { pm.expect.fail('Onboarding submit hit FOREIGN_KEY_VIOLATION — the resolved category_id does not exist on ' + pm.variables.get('base_url')); });",
              "  }",
              "}",
              "pm.test('Status is 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "var json = pm.response.json();",
              "pm.test('success true', function () { pm.expect(json.success).to.be.true; });",
              "// Regression guard: confirm onboarding fields actually persisted (bio bug)",
              "pm.sendRequest({",
              "  url: pm.variables.get('base_url') + '/api/v1/experts/me',",
              "  method: 'GET',",
              "  header: [{ key: 'Authorization', value: 'Bearer ' + pm.collectionVariables.get('expert_token') }]",
              "}, function (err, res) {",
              "  var me = res.json().data;",
              "  pm.test('bio persisted', function () { pm.expect(me.bio).to.eql('Seasoned professional with extensive industry experience. Email-onboarded init flow account.'); });",
              "  pm.test('headline persisted', function () { pm.expect(me.headline).to.eql('Industry Expert'); });",
              "  pm.test('title persisted', function () { pm.expect(me.title).to.eql('Senior Consultant'); });",
              "  pm.test('businessName persisted', function () { pm.expect(me.businessName).to.eql('XpertLink Consulting LLC'); });",
              "  pm.test('consultationRate persisted', function () { pm.expect(me.consultationRate).to.eql(150); });",
              "  pm.test('experienceYears persisted', function () { pm.expect(me.experienceYears).to.eql(10); });",
              "  pm.test('languages persisted', function () { pm.expect(me.languages).to.include('English'); });",
              "  pm.test('serviceAreas persisted', function () { pm.expect(me.serviceAreas.length).to.be.above(0); });",
              "  pm.test('category persisted', function () { pm.expect((me.categories || []).map(function (c) { return c.id; })).to.include(pm.collectionVariables.get('category_id')); });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{expert_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
