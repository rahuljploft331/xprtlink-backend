    {
      "name": "Step 4b: Admin Finds This Expert's Verification (in_progress)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('List in_progress verifications 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "var items = (json.data && json.data.items) ? json.data.items : [];",
              "var expertId = pm.collectionVariables.get('expert_profile_id');",
              "var match = items.filter(function (v) { return v.expert && v.expert.id === expertId; })[0];",
              "pm.test('Found verification for this expert', function () { pm.expect(match, 'no in_progress verification for expert ' + expertId).to.not.be.undefined; });",
              "if (match) { pm.collectionVariables.set('verification_id', match.id); }"
            ],
