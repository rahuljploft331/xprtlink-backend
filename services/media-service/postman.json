{
  "info": {
    "_postman_id": "c1f7b7cb-4b3d-4c3e-8848-12cd80a1c6a8",
    "name": "Media Service",
    "description": "REST APIs for signed URL uploads and resolving media asset metadata.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Signed Upload URL",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fileName\": \"receipt.jpg\",\n  \"fileType\": \"image/jpeg\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/media/uploads",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "media",
            "uploads"
          ]
        },
        "description": "Request a signed URL to upload media files (e.g. quote attachments, verification documents)."
      }
    },
    {
      "name": "Resolve Media Asset Detail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/media/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "media",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "media-uuid-here"
            }
          ]
        },
        "description": "Resolve metadata and direct URL of a uploaded media asset."
      }
    }
  ]
}
