{
  "info": {
    "_postman_id": "c1f7b7cb-4b3d-4c3e-8848-12cd80a1c6a7",
    "name": "Notification Service",
    "description": "REST APIs for Firebase Cloud Messaging (FCM) device registration, in-app notification logs, and user preference setups.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Device Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceToken\": \"fcm-registration-token-string\",\n  \"platform\": \"android\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/notifications/device-token",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "device-token"
          ]
        },
        "description": "Register FCM push token for the logged in device after authentication."
      }
    },
    {
      "name": "Get Unread Count",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/notifications/unread-count",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "unread-count"
          ]
        },
        "description": "Get count of unread notifications for dashboard badges."
      }
    },
    {
      "name": "Get Notifications (Paginated)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/notifications?page=1&limit=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "Get paginated inbox list of all notifications."
      }
    },
    {
      "name": "Mark One Notification Read",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/notifications/:id/read",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            ":id",
            "read"
          ],
          "variable": [
            {
              "key": "id",
              "value": "notification-uuid-here"
            }
          ]
        },
        "description": "Mark a single notification read."
      }
    },
    {
      "name": "Mark All Notifications Read",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/notifications/read-all",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "read-all"
          ]
        },
        "description": "Mark all notifications read."
      }
    },
    {
      "name": "Get Notification Preferences",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/notifications/preferences",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "preferences"
          ]
        },
        "description": "Fetch user notification configs."
      }
    },
    {
      "name": "Update Notification Preferences",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailNotifications\": true,\n  \"pushNotifications\": true,\n  \"smsNotifications\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/notifications/preferences",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "preferences"
          ]
        },
        "description": "Modify user notification configurations."
      }
    },
    {
      "name": "Clear One Notification (Soft Delete)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/notifications/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "notification-uuid-here"
            }
          ]
        },
        "description": "Soft-delete a single notification for the authenticated user. The row is never removed - a cleared_at timestamp is stamped and every read path (list, list count, unread count) filters it out. Scoped by userId: clearing another user's notification returns 404. Idempotent - calling it again on an already-cleared notification returns 200, not 404. Available to both the customer and expert apps. Returns { cleared: true }."
      }
    },
    {
      "name": "Clear All Notifications (Soft Delete)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/notifications",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications"
          ]
        },
        "description": "Soft-delete every notification for the authenticated user. Non-destructive - rows are retained with cleared_at set, so notification history and payload deep-link data survive. Available to both the customer and expert apps. Returns { cleared: <count> }."
      }
    }
  ]
}
