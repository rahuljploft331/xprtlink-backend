  },
  "item": [
    {
      "name": "Quotes",
      "item": [
        {
          "name": "Create Quote Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expertId\": \"expert-uuid-here\",\n  \"title\": \"Need consultation on database architecture\",\n  \"description\": \"Require help sizing tables and setting up indexes.\",\n  \"category\": \"Database Design\",\n  \"preferredLocation\": \"Remote / Video call\",\n  \"budget\": 200.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/engagement/quotes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "engagement",
                "quotes"
              ]
            },
            "description": "Customer submits a new quote request to an expert. Accepts expertId (optional), title, description, category (optional), preferredLocation (optional), and budget (optional). The response includes a generated referenceNumber."
          }
        },
        {
          "name": "Update Quote Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Need consultation on database architecture\",\n  \"description\": \"Updated description with more details.\",\n  \"category\": \"Database Design\",\n  \"preferredLocation\": \"Remote / Video call\",\n  \"budget\": 250.00,\n  \"mediaIds\": [\"media-uuid-1\"],\n  \"notes\": \"Added indexing requirements.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/engagement/quotes/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "engagement",
                "quotes",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "quote-uuid-here"
                }
              ]
            },
            "description": "Update a quote request. Accepts title, description, category, preferredLocation, budget, mediaIds, and notes (all optional)."
          }
        },
        {
          "name": "List Quotes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/engagement/quotes?role=customer&page=1&limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "engagement",
                "quotes"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "expert"
                },
                {
                  "key": "inbox",
                  "value": "true",
                  "description": "Experts only: when true, returns only requests awaiting a quotation (status = pending_expert_review)."
                },
                {
                  "key": "status",
                  "value": "pending_expert_review",
                  "description": "Optional status filter: submitted, pending_expert_review, quoted, accepted, rejected, canceled, expired.",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Get lists of quote requests (inbound for experts, outbound for customers). Pass role=expert to view the expert inbox; add inbox=true to show only requests awaiting a quotation, or status=<value> to filter. Each item includes referenceNumber, title, category, status, customerName, and timestamps."
          }
        },
