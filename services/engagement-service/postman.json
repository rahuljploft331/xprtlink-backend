{
  "info": {
    "_postman_id": "c1f7b7cb-4b3d-4c3e-8848-12cd80a1c6a4",
    "name": "Engagement Service",
    "description": "REST APIs for quotes, video consultations, billing summaries, reviews, and reporting experts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Quotes",
      "item": [
        {
          "name": "Create Quote Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expertId\": \"expert-uuid-here\",\n  \"title\": \"Need consultation on database architecture\",\n  \"description\": \"Require help sizing tables and setting up indexes.\",\n  \"category\": \"Database Design\",\n  \"preferredLocation\": \"Remote / Video call\",\n  \"budget\": 200.00,\n  \"notes\": \"Priority on the private consultation rooms.\",\n  \"mediaIds\": [\"media-uuid-1\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/engagement/quotes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "engagement",
                "quotes"
              ]
            },
            "description": "Customer submits a new quote request to an expert. Accepts expertId (optional), title, description, category (optional), preferredLocation (optional), budget (optional), notes (optional customer note), and mediaIds (optional array of uploaded media UUIDs to attach). The response is a quote detail object including a generated referenceNumber, notes, expert card fields (expertName, expertTitle, expertHeadline, expertAvatarUrl), contact fields (contactName, contactPhone, customerAvatarUrl), and attachments (id, mediaId, url, mimeType)."
          }
        },
        {
          "name": "Update Quote Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Need consultation on database architecture\",\n  \"description\": \"Updated description with more details.\",\n  \"category\": \"Database Design\",\n  \"preferredLocation\": \"Remote / Video call\",\n  \"budget\": 250.00,\n  \"mediaIds\": [\"media-uuid-1\"],\n  \"notes\": \"Added indexing requirements.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/engagement/quotes/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "engagement",
                "quotes",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "00000000-0000-4000-8000-000000000000"
                }
              ]
            },
            "description": "Update a quote request. Accepts title, description, category, preferredLocation, budget, mediaIds, and notes (all optional)."
          }
        },
        {
          "name": "List Quotes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/engagement/quotes?role=customer&page=1&limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "engagement",
                "quotes"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "expert"
                },
                {
                  "key": "inbox",
                  "value": "true",
                  "description": "Experts only: when true, returns only requests awaiting the expert's action (status pending_expert_review or expert_reviewed)."
                },
                {
                  "key": "status",
                  "value": "pending_expert_review",
                  "description": "Optional status filter: submitted, pending_expert_review, expert_reviewed, quoted, accepted, rejected, canceled, expired.",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Get lists of quote requests (inbound for experts, outbound for customers). Pass role=expert to view the expert inbox; add inbox=true to show only requests awaiting a quotation, or status=<value> to filter. Paginated response: data.{items,page,limit,total}. Each item includes referenceNumber, title, category, status, expertName, expertAvatarUrl, customerName, budget, currency, attachmentCount (for the file-count chip), and timestamps."
          }
        },
        {
          "name": "Get Quote Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/engagement/quotes/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "engagement",
                "quotes",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "00000000-0000-4000-8000-000000000000"
                }
              ]
            },
            "description": "Fetch detailed information of a quote request. Response fields: id, referenceNumber, title, description, notes (customer note), category, preferredLocation, status, budget, currency, expert card (expertId, expertName, expertTitle, expertHeadline, expertAvatarUrl), contact info (customerId, customerName, contactName, contactPhone, customerAvatarUrl), attachments[{id, mediaId, url, mimeType}], expertQuote{amount, currency, notes, quotedAt} (non-null once status is 'quoted'), and timestamps (expiresAt, submittedAt, resolvedAt, createdAt, updatedAt)."
          }
        },
        {
          "name": "Submit Quotation (Expert)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 150.00,\n  \"timeline\": \"5 Business Days\",\n  \"notes\": \"I can finish this in one session.\",\n  \"mediaIds\": [\"media-uuid-1\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/engagement/quotes/:id/quotation",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "engagement",
                "quotes",
                ":id",
                "quotation"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "00000000-0000-4000-8000-000000000000"
                }
              ]
            },
            "description": "Expert submits a quotation back to the customer. Body: amount (required, positive), timeline (optional, e.g. \"5 Business Days\"), notes (optional), and mediaIds (optional array of uploaded media UUIDs the expert attaches to the quotation). Valid when the quote status is pending_expert_review or expert_reviewed; moves the quote to `quoted`. The response's expertQuote block includes amount, currency, notes, timeline, and quotedAt. Attachments returned in the quote detail carry an uploadedByRole field (`customer` or `expert`) so clients can separate the customer's request files from the expert's quotation files."
          }
        },
        {
          "name": "Accept Quote (Customer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
