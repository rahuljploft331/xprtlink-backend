        },
        {
          "name": "Cancel Quote (Customer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/engagement/quotes/:id/cancel",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "engagement",
                "quotes",
                ":id",
                "cancel"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "quote-uuid-here"
                }
              ]
            },
            "description": "Cancel the quote request."
          }
        },
        {
          "name": "Get Quote History & Audit Trail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/engagement/quotes/:id/history",
              "host": [
                "{{base_url}}"
