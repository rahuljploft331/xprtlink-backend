                "engagement",
                "quotes",
                ":id",
                "accept"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "00000000-0000-4000-8000-000000000000"
                }
              ]
            },
            "description": "Customer accepts the expert's quotation estimate."
          }
        },
        {
          "name": "Reject Quote (Customer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/engagement/quotes/:id/reject",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "engagement",
