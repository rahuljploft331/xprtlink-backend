    {
      "name": "Webhooks",
      "item": [
        {
          "name": "ZegoCloud Callback (server-to-server)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appid\": \"283072073\",\n  \"event\": \"room_close\",\n  \"nonce\": \"abc123\",\n  \"timestamp\": \"1723536000\",\n  \"signature\": \"computed-sha1-hex\",\n  \"room_id\": \"room-xxxx-xxxx\"\n}"
