                "quotes",
                ":id",
                "history"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "00000000-0000-4000-8000-000000000000"
                }
              ]
            },
            "description": "Load the status change history log list of the quote."
          }
        }
      ]
    },
