                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primaryId\": \"media-uuid-front\",\n  \"secondaryId\": \"media-uuid-back\",\n  \"docType\": \"government_id\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/experts/me/verification/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                "me",
                "verification",
                "documents"
              ]
            },
            "description": "Submit verification documents. Uses primaryId (required UUID) and secondaryId (optional UUID) for document media references. docType: government_id | credential | other. On success the verification and the expert's verificationStatus move to 'in_progress' (documents uploaded and in review). Response: { submitted, documentCount, primaryId, secondaryId }.\n\nNOTE: the sample body uses placeholder (non-UUID) media IDs and therefore expects a 400 VALIDATION_ERROR. Provide real media UUIDs (from a Media Service upload) to exercise the success path."
          }
        },
        {
          "name": "Get Expert Dashboard Stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "t-dashboard",
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('response is JSON', () => pm.response.to.be.json);",
                  "pm.test('has earnings breakdown fields', function () {",
                  "  const d = pm.response.json().data || {};",
                  "  pm.expect(d).to.have.property('earningsTodayCents');",
                  "  pm.expect(d).to.have.property('earningsThisWeekCents');",
                  "  pm.expect(d).to.have.property('earningsThisMonthCents');",
                  "});",
                  "pm.test('has recentActivity object', function () {",
                  "  const d = pm.response.json().data || {};",
                  "  pm.expect(d).to.have.property('recentActivity');",
                  "  pm.expect(d.recentActivity).to.have.property('newRequest');",
                  "  pm.expect(d.recentActivity).to.have.property('latestMessage');",
                  "  pm.expect(d.recentActivity).to.have.property('lastCompleted');",
                  "});"
                ]
              }
            }
          ],
