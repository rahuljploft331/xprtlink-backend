{
  "info": {
    "_postman_id": "c1f7b7cb-4b3d-4c3e-8848-12cd80a1c6a2",
    "name": "Expert Service",
    "description": "REST APIs for expert profile management, search/featured, ratings/reviews, and onboarding verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Marketplace & Discovery",
      "item": [
        {
          "name": "Get Featured Experts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/experts/featured",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                "featured"
              ]
            },
            "description": "Get active, verified, paid experts for the dashboard featured list."
          }
        },
        {
          "name": "Search Experts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/search/experts?q=development&category=software&sort=rating&page=1&limit=20&lat=37.7749&lng=-122.4194&radius=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "search",
                "experts"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "development"
                },
                {
                  "key": "category",
                  "value": "software"
                },
                {
                  "key": "sort",
                  "value": "rating"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "lat",
                  "value": "37.7749",
                  "description": "Customer latitude for geo-distance filter (optional)"
                },
                {
                  "key": "lng",
                  "value": "-122.4194",
                  "description": "Customer longitude for geo-distance filter (optional)"
                },
                {
                  "key": "radius",
                  "value": "50",
                  "description": "Search radius in km (default: 50, optional)"
                }
              ]
            },
            "description": "Search for experts in the marketplace.\n\nQuery parameters: q, category, priceMin, priceMax, rating, experience, online, verified, sort, page, limit.\n\nGeo-distance filter (optional): lat, lng, radius (km, default 50). When lat+lng are provided, results are filtered to experts with at least one serviceArea location within the radius, sorted by nearest distance. Response includes a `distance` field (km) per expert."
          }
        },
        {
          "name": "Get Expert Profile by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/experts/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "expert-uuid-here"
                }
              ]
            },
            "description": "Get detailed public profile of an expert."
          }
        },
        {
          "name": "Get Expert Reviews",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/experts/:id/reviews?page=1&limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                ":id",
                "reviews"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "expert-uuid-here"
                }
              ]
            },
            "description": "List reviews and ratings of an expert."
          }
        },
        {
          "name": "Get Expert Availability Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/experts/:id/availability",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                ":id",
                "availability"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "expert-uuid-here"
                }
              ]
            },
            "description": "Check real-time availability/callability status on the expert profile."
          }
        }
      ]
    },
    {
      "name": "Expert Dashboard & Settings (Authenticated Expert)",
      "item": [
        {
          "name": "Get Profile Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/experts/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                "me"
              ]
            },
            "description": "Load the authenticated expert's professional hub details."
          }
        },
        {
          "name": "Update Profile Me",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Senior Cloud Architect with 10+ years experience.\",\n  \"title\": \"Cloud Solutions Architect\",\n  \"businessName\": \"CloudPro Consulting\",\n  \"languages\": [\"English\", \"Spanish\"],\n  \"serviceAreas\": [{\"name\": \"New York, NY\", \"lat\": 40.7128, \"lng\": -74.006}, {\"name\": \"San Francisco, CA\", \"lat\": 37.7749, \"lng\": -122.4194}],\n  \"consultationRate\": 120,\n  \"experienceYears\": 10,\n  \"availabilityStatus\": \"online\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/experts/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                "me"
              ]
            },
            "description": "Update professional information, rates, and availability. Accepts: headline, bio, title, businessName, languages (string[]), serviceAreas (array of {name, lat, lng} objects), consultationRate, experienceYears, availabilityStatus, categoryId, avatarMediaId."
          }
        },
        {
          "name": "Submit Onboarding Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"headline\": \"Expert Cloud Architect\",\n  \"bio\": \"Experienced professional ready for consultations.\",\n  \"title\": \"Senior Consultant\",\n  \"businessName\": \"My Consulting LLC\",\n  \"languages\": [\"English\"],\n  \"serviceAreas\": [{\"name\": \"Austin, TX\", \"lat\": 30.2672, \"lng\": -97.7431}],\n  \"consultationRate\": 100,\n  \"experienceYears\": 5,\n  \"categoryId\": \"category-uuid-here\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/experts/me/onboarding/submit",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                "me",
                "onboarding",
                "submit"
              ]
            },
            "description": "Submit onboarding application for admin review. Accepts the same body as Save Onboarding Draft (all fields optional): headline, bio, title, businessName, languages (string[]), serviceAreas (array of {name, lat, lng}), consultationRate, experienceYears, categoryId, avatarMediaId."
          }
        },
        {
          "name": "Get Verification Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/experts/me/verification",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                "me",
                "verification"
              ]
            },
            "description": "Load ID / professional verification status details. status: unverified | pending | in_progress | approved | rejected | resubmit_required ('in_progress' = documents uploaded and awaiting admin review)."
          }
        },
        {
          "name": "Submit Verification Documents",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primaryId\": \"media-uuid-front\",\n  \"secondaryId\": \"media-uuid-back\",\n  \"docType\": \"government_id\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/experts/me/verification/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                "me",
                "verification",
                "documents"
              ]
            },
            "description": "Submit verification documents. Uses primaryId (required UUID) and secondaryId (optional UUID) for document media references. docType: government_id | credential | other. On success the verification and the expert's verificationStatus move to 'in_progress' (documents uploaded and in review). Response: { submitted, documentCount, primaryId, secondaryId }."
          }
        },
        {
          "name": "Get Expert Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/experts/me/dashboard",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                "me",
                "dashboard"
              ]
            },
            "description": "Load active practice numbers and subscription restrictions."
          }
        },
        {
          "name": "Get Rating Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/experts/me/rating-summary",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                "me",
                "rating-summary"
              ]
            },
            "description": "Get detailed average ratings and star breakdown summary."
          }
        },
        {
          "name": "Get My Reviews (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/experts/me/reviews?page=1&limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                "me",
                "reviews"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Fetch reviews left by customers for the authenticated expert."
          }
        },
        {
          "name": "Get Settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/experts/me/settings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                "me",
                "settings"
              ]
            },
            "description": "Get config preferences for the expert dashboard."
          }
        },
        {
          "name": "Update Settings",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preferences\": {\n    \"holidayMode\": false,\n    \"vacationStart\": null,\n    \"vacationEnd\": null\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/experts/me/settings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                "me",
                "settings"
              ]
            },
            "description": "Modify configurations/settings for the expert. Body must wrap settings in a `preferences` object (record of arbitrary keys, max 10KB), e.g. { \"preferences\": { \"holidayMode\": false, \"vacationStart\": null, \"vacationEnd\": null } }."
          }
        }
      ]
    }
  ]
}
