        {
          "name": "Submit Onboarding Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "t-onboarding",
                "type": "text/javascript",
                "exec": [
                  "// The sample body uses a non-UUID placeholder in `categoryIds`, so the API is expected",
                  "// to reject it with a 400 VALIDATION_ERROR. Provide real category UUIDs (or omit",
                  "// categoryIds) in the body to exercise the success path (200).",
                  "pm.test('rejects non-UUID categoryIds with 400 VALIDATION_ERROR', function () {",
                  "  pm.response.to.have.status(400);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(body.field).to.match(/^categoryIds(\\.\\d+)?$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"headline\": \"Expert Cloud Architect\",\n  \"bio\": \"Experienced professional ready for consultations.\",\n  \"title\": \"Senior Consultant\",\n  \"businessName\": \"My Consulting LLC\",\n  \"languages\": [\"English\"],\n  \"serviceAreas\": [{\"name\": \"Austin, TX\", \"lat\": 30.2672, \"lng\": -97.7431}],\n  \"consultationRate\": 100,\n  \"experienceYears\": 5,\n  \"categoryIds\": [\"category-uuid-here\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/experts/me/onboarding/submit",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "experts",
                "me",
                "onboarding",
                "submit"
              ]
            },
            "description": "Submit onboarding application for admin review. Accepts the same body as Save Onboarding Draft (all fields optional): headline, bio, title, businessName, languages (string[]), serviceAreas (array of {name, lat, lng}), consultationRate, experienceYears, categoryIds (array of category UUIDs, min 1 when provided), avatarMediaId.\n\nNOTE: the sample body uses a placeholder (non-UUID) in `categoryIds` and therefore expects a 400 VALIDATION_ERROR. Provide real category UUIDs (or omit categoryIds) to exercise the success path (200)."
          }
