              "path": [
                "api",
                "v1",
                "experts",
                "me",
                "dashboard"
              ]
            },
            "description": "Load the expert dashboard: active practice numbers, earnings, subscription card, and recent activity feed.\n\nResponse shape (data):\n- availabilityStatus, verificationStatus, subscriptionActive\n- pendingQuoteCount, activeConsultationCount, unreadNotificationCount\n- earningsTodayCents, earningsThisWeekCents, earningsThisMonthCents (integer cents, aggregated from the expert earnings ledger for the current day / rolling 7 days / current calendar month)\n- subscription: null | { planName, status, cancelAtPeriodEnd, currentPeriodEnd } (the active subscription, if any)\n- recentActivity: {\n    newRequest: null | { type: 'quote', id, title, description, customerName, status, createdAt } — latest quote pending expert review,\n    latestMessage: null | { conversationId, peerName, preview, createdAt } — latest inbound message from a customer,\n    lastCompleted: null | { consultationId, customerName, endedAt, rating, comment } — most recently completed consultation (rating/comment from its review if present)\n  }"
          }
