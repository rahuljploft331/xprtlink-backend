                  "// to exercise the success path.",
                  "pm.test('rejects non-UUID media ids with 400 VALIDATION_ERROR', function () {",
                  "  pm.response.to.have.status(400);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(body.field).to.eql('primaryId');",
                  "});"
                ]
              }
            }
