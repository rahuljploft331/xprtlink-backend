{
  "info": {
    "_postman_id": "ea16c2da-ed0f-4b72-9796-12cac4fafa35",
    "name": "User Service",
    "description": "REST APIs for registration (2-step OTP flow), login, OTP validation, password management, social auth, and customer profile/discoveries.\n\n**Registration (2 steps):**\n1. POST /auth/register — requires email + phone (E.164), confirmPassword, termsAccepted, MFS password rules\n2. POST /auth/otp/verify { purpose: register } → auth tokens\n\n**Social signup (when phone missing):**\n1. POST /auth/social → may return completionToken\n2. POST /auth/social/complete → OTP to phone\n3. POST /auth/otp/verify { purpose: verify_phone } → auth tokens",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth & Session",
      "item": [
        {
          "name": "Get Session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/session",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "session"]
            },
            "description": "Splash screen session validation. Returns role and onboarding/verification gates (emailVerified, expertSubscriptionActive, etc.)."
          }
        },
        {
          "name": "Register — Step 1 (send OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"phone\": \"+14155552671\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"role\": \"customer\",\n  \"termsAccepted\": true,\n  \"otpChannel\": \"phone\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Step 1 of 2-step registration.\n\nCreates a pending_verification User with both email and phone. Sends a 6-digit OTP (default: phone).\n\n**Response:** `{ sent: true, expiresInSeconds, channel }`\n\nRequired: firstName, lastName, email, phone (E.164), password (MFS rules), confirmPassword, termsAccepted: true, role.\nOptional: otpChannel ('email' | 'phone', default phone)."
          }
        },
        {
          "name": "Register — Step 2 (verify OTP → get tokens)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+14155552671\",\n  \"code\": \"123456\",\n  \"purpose\": \"register\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/otp/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "otp", "verify"]
            },
            "description": "Step 2 of 2-step registration.\n\nVerify OTP sent to email or phone (match otpChannel from step 1). Stamps both emailVerifiedAt and phoneVerifiedAt, creates profile, issues tokens."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Log in and obtain access & refresh tokens.\n\nIf using `email`, `password` is required and tokens are returned instantly.\nIf using `phone`, `password` is optional. The API will generate an OTP and return `{ needsOtp: true, ... }` instead of tokens. The mobile app must then call `/auth/otp/verify` with `purpose: login`.\n\nReturns 403 EMAIL_NOT_VERIFIED if the account is pending_verification (user should complete Step 2 instead)."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Revoke the refresh token and sign out."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Issue a new access token using a valid refresh token."
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"purpose\": \"verify_email\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/otp/send",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "otp", "send"]
            },
            "description": "Send an OTP code via Email or Mobile.\n\nPurpose: 'verify_email' | 'verify_phone' | 'reset_password'\n\nNote: purpose='register' is NOT supported here — use POST /auth/register instead."
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+11234567890\",\n  \"code\": \"123456\",\n  \"purpose\": \"login\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/otp/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "otp", "verify"]
            },
            "description": "Verify an OTP code.\n\nField is 'code', NOT 'otp'.\n\nBehaviour by purpose:\n- 'register'       → returns auth tokens (see 'Register — Step 2')\n- 'login'          → returns auth tokens (used after phone login)\n- 'verify_email'   → stamps emailVerifiedAt, returns { verified: true }\n- 'verify_phone'   → stamps phoneVerifiedAt, returns { verified: true }\n- 'reset_password' → validates code only, returns { verified: true }"
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"purpose\": \"verify_email\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/otp/resend",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "otp", "resend"]
            },
            "description": "Resend an OTP code. Same rules as Send OTP — purpose='register' is not supported here (re-call /auth/register instead)."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password/forgot",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "password", "forgot"]
            },
            "description": "Initiate password reset. Sends a reset code to email/phone."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"code\": \"123456\",\n  \"newPassword\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password/reset",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "password", "reset"]
            },
            "description": "Set a new password using a reset OTP code.\n\nField is 'code', NOT 'otp'."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password/change",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "password", "change"]
            },
            "description": "Change password for an authenticated session.\n\nField is 'currentPassword', NOT 'oldPassword'."
          }
        },
        {
          "name": "Check Availability (email)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/check-availability?email=user@example.com",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "check-availability"],
              "query": [
                {
                  "key": "email",
                  "value": "user@example.com"
                }
              ]
            },
            "description": "Check if an email is available during onboarding.\n\npending_verification users are treated as available (they can re-register to get a fresh OTP).\n\nReturns: `{ emailAvailable: boolean }`"
          }
        },
        {
          "name": "Check Availability (phone)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/check-availability?mobile=%2B14155552671",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "check-availability"],
              "query": [
                {
                  "key": "mobile",
                  "value": "%2B14155552671",
                  "description": "E.164 phone number (URL-encode the leading '+' as %2B, or omit it — server normalizes automatically)"
                }
              ]
            },
            "description": "Check if a mobile number is available during onboarding.\n\nAccepts query param `mobile` or `phone` in E.164 format. The server normalizes the value: trims whitespace, restores a leading '+' if it was decoded as a space or omitted.\n\npending_verification users are treated as available.\n\nReturns: `{ phoneAvailable: boolean }`"
          }
        },
        {
          "name": "Login (by phone)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+14155552671\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Log in with mobile number (E.164). Password is not required. This triggers an OTP SMS and returns `{ needsOtp: true, ... }`."
          }
        },
        {
          "name": "Social Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"google\",\n  \"idToken\": \"firebase-id-token-from-mobile-sdk\",\n  \"role\": \"customer\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/social",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "social"]
            },
            "description": "Google or Apple sign-in via Firebase ID token.\n\nReturns auth tokens on success, or `{ needsProfileCompletion: true, missing: ['phone'], completionToken }` when phone is required."
          }
        },
        {
          "name": "Social Complete (collect phone)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completionToken\": \"{{completionToken}}\",\n  \"phone\": \"+14155552671\",\n  \"termsAccepted\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/social/complete",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "social", "complete"]
            },
            "description": "Complete social signup by providing phone. Sends OTP; verify with POST /auth/otp/verify { purpose: verify_phone }."
          }
        }
      ]
    },
    {
      "name": "Customer Profile",
      "item": [
        {
          "name": "Get Profile Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customers", "me"]
            },
            "description": "Load the authenticated customer profile."
          }
        },
        {
          "name": "Update Profile Me",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"avatarMediaId\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customers", "me"]
            },
            "description": "Update the authenticated customer profile.\n\nAccepted fields:\n- firstName (string, optional)\n- lastName (string, optional)\n- avatarMediaId (UUID of an uploaded MediaAsset, or null — NOT a URL string)\n\nAll fields are optional (PATCH semantics)."
          }
        },
        {
          "name": "Delete Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me/delete",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customers", "me", "delete"]
            },
            "description": "Soft-delete the authenticated customer account (sets status=deleted)."
          }
        },
        {
          "name": "Get Recently Viewed Experts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me/recently-viewed?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customers", "me", "recently-viewed"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Fetch a paginated history list of experts recently viewed by the customer."
          }
        },
        {
          "name": "Record Recently Viewed Expert",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me/recently-viewed/:expertId",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customers", "me", "recently-viewed", ":expertId"],
              "variable": [
                { "key": "expertId", "value": "expert-uuid-here" }
              ]
            },
            "description": "Record that an expert profile was viewed."
          }
        },
        {
          "name": "Get Saved Experts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me/saved-experts?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customers", "me", "saved-experts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "List the customer's bookmarked or saved experts."
          }
        },
        {
          "name": "Save Expert",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me/saved-experts/:expertId",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customers", "me", "saved-experts", ":expertId"],
              "variable": [
                { "key": "expertId", "value": "expert-uuid-here" }
              ]
            },
            "description": "Save/bookmark an expert profile."
          }
        },
        {
          "name": "Unsave Expert",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me/saved-experts/:expertId",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customers", "me", "saved-experts", ":expertId"],
              "variable": [
                { "key": "expertId", "value": "expert-uuid-here" }
              ]
            },
            "description": "Remove an expert from the saved list."
          }
        }
      ]
    }
  ]
}
