{
  "info": {
    "_postman_id": "f5b66d80-5a3d-4c3e-8848-12cd80a1c6a1",
    "name": "User Service",
    "description": "REST APIs for registration, login, OTP validation, password management, and customer profile/discoveries.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth & Session",
      "item": [
        {
          "name": "Get Session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/session",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "session"
              ]
            },
            "description": "Splash screen session validation. Returns role and onboarding/verification gates."
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\",\n  \"fullName\": \"John Doe\",\n  \"role\": \"customer\",\n  \"mobile\": \"+1234567890\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Register a new user. Role can be 'customer' or 'expert'."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Log in and obtain access & refresh tokens."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Revoke the refresh token and sign out."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Issue a new access token using a valid refresh token."
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"purpose\": \"verify_email\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/otp/send",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "otp",
                "send"
              ]
            },
            "description": "Send an OTP code via Email or Mobile. Purpose: 'verify_email' | 'reset_password'."
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\",\n  \"purpose\": \"verify_email\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/otp/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "otp",
                "verify"
              ]
            },
            "description": "Verify an OTP code."
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"purpose\": \"verify_email\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/otp/resend",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "otp",
                "resend"
              ]
            },
            "description": "Resend an OTP code."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password/forgot",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "password",
                "forgot"
              ]
            },
            "description": "Initiate password reset. Sends a reset code."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password/reset",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "password",
                "reset"
              ]
            },
            "description": "Set a new password using a reset OTP code."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"Password123!\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password/change",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "password",
                "change"
              ]
            },
            "description": "Change password for an authenticated session."
          }
        },
        {
          "name": "Check Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/check-availability?email=user@example.com",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "check-availability"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "user@example.com"
                }
              ]
            },
            "description": "Check if an email or mobile is available during onboarding."
          }
        },
        {
          "name": "Social Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"google\",\n  \"token\": \"social-auth-token\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/social",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "social"
              ]
            },
            "description": "Authenticate via Google or Apple OAuth."
          }
        }
      ]
    },
    {
      "name": "Customer Profile",
      "item": [
        {
          "name": "Get Profile Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "me"
              ]
            },
            "description": "Load the authenticated customer profile."
          }
        },
        {
          "name": "Update Profile Me",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"avatarUrl\": \"https://example.com/new-avatar.png\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "me"
              ]
            },
            "description": "Update details of the authenticated customer profile."
          }
        },
        {
          "name": "Delete Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me/delete",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "me",
                "delete"
              ]
            },
            "description": "Request deletion of the authenticated customer account."
          }
        },
        {
          "name": "Get Recently Viewed Experts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me/recently-viewed?page=1&limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "me",
                "recently-viewed"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Fetch a paginated history list of experts recently viewed by the customer."
          }
        },
        {
          "name": "Record Recently Viewed Expert",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me/recently-viewed/:expertId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "me",
                "recently-viewed",
                ":expertId"
              ],
              "variable": [
                {
                  "key": "expertId",
                  "value": "expert-uuid-here"
                }
              ]
            },
            "description": "Record that an expert profile was viewed."
          }
        },
        {
          "name": "Get Saved Experts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me/saved-experts?page=1&limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "me",
                "saved-experts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "List the customer's bookmarked or saved experts."
          }
        },
        {
          "name": "Save Expert",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me/saved-experts/:expertId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "me",
                "saved-experts",
                ":expertId"
              ],
              "variable": [
                {
                  "key": "expertId",
                  "value": "expert-uuid-here"
                }
              ]
            },
            "description": "Save/bookmark an expert profile."
          }
        },
        {
          "name": "Unsave Expert",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/me/saved-experts/:expertId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "me",
                "saved-experts",
                ":expertId"
              ],
              "variable": [
                {
                  "key": "expertId",
                  "value": "expert-uuid-here"
                }
              ]
            },
            "description": "Remove an expert from the saved list."
          }
        }
      ]
    }
  ]
}
