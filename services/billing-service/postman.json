    {
      "id": "57225879-77777777-0000-4000-8000-000000000001",
      "name": "Internal / Cron",
      "item": [
        {
          "id": "57225879-77777777-0000-4000-8000-000000000002",
          "name": "Expire Subscriptions (Cron)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/billing/subscriptions/expire",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "subscriptions",
                "expire"
              ]
            },
            "description": "Internal cron endpoint to expire subscriptions past their period end. Should be protected with internal secret header or restricted to localhost in production."
          }
        },
        {
          "id": "57225879-77777777-0000-4000-8000-000000000004",
          "name": "Retry Failed Captures (Cron)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-internal-service",
                "value": "{{service_secret}}",
                "description": "Required — internal service secret. Guards this endpoint from public access."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"graceMinutes\": 2,\n  \"maxAgeDays\": 7,\n  \"limit\": 100\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/billing/consultations/retry-captures",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "consultations",
                "retry-captures"
              ]
            },
            "description": "Internal cron endpoint. Finds consultations that completed but were never charged (room_close → capture handoff failed or left billingStatus=failed) and re-invokes the idempotent capture path. Body params are optional overrides: graceMinutes (skip calls that just ended), maxAgeDays (stop retrying uncollectible calls), limit (batch size). Returns { scanned, charged, stillFailed, skipped }."
