{
  "info": {
    "_postman_id": "c1f7b7cb-4b3d-4c3e-8848-12cd80a1c6a6",
    "name": "Billing Service",
    "description": "REST APIs for Stripe customer payment methods, subscription plans, expert payouts/earnings, and billing transactions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Payment Methods (Customer)",
      "item": [
        {
          "name": "List Payment Methods",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/billing/payment-methods",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "payment-methods"
              ]
            },
            "description": "List all saved payment methods of the customer."
          }
        },
        {
          "name": "Add Payment Method",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethodId\": \"pm_card_visa\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/billing/payment-methods",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "payment-methods"
              ]
            },
            "description": "Associate a new Stripe payment method with the customer."
          }
        },
        {
          "name": "Remove Payment Method",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/billing/payment-methods/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "payment-methods",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "pm-uuid-here"
                }
              ]
            },
            "description": "Delete a customer's saved payment method."
          }
        }
      ]
    },
    {
      "name": "Payments & Transactions",
      "item": [
        {
          "name": "Pay Consultation Call",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethodId\": \"pm_card_visa\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/billing/consultations/:id/pay",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "consultations",
                ":id",
                "pay"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "consultation-uuid-here"
                }
              ]
            },
            "description": "Process Stripe charge payment for a completed consultation call."
          }
        },
        {
          "name": "Get Transaction Receipt Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/billing/transactions/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "transactions",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "transaction-uuid-here"
                }
              ]
            },
            "description": "Get Stripe receipt details of a financial transaction."
          }
        }
      ]
    },
    {
      "name": "Subscriptions (Expert)",
      "item": [
        {
          "name": "List Subscription Plans",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/billing/subscriptions/plans",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "subscriptions",
                "plans"
              ]
            },
            "description": "List subscription plans available for experts."
          }
        },
        {
          "name": "Subscribe to Plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"premium_plan_id\",\n  \"paymentMethodId\": \"pm_card_visa\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/billing/subscriptions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "subscriptions"
              ]
            },
            "description": "Subscribe the expert to a membership plan."
          }
        },
        {
          "name": "Get My Subscription",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/billing/subscriptions/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "subscriptions",
                "me"
              ]
            },
            "description": "Retrieve current plan info and active subscription state of the expert."
          }
        }
      ]
    },
    {
      "name": "Earnings (Expert)",
      "item": [
        {
          "name": "Get Earnings History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/billing/earnings?page=1&limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "earnings"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Get expert consultation earnings transaction log history."
          }
        }
      ]
    }
  ]
}
