{
  "info": {
    "_postman_id": "fad6dcbe-8bc4-4d3f-8ef2-d4b8443bc89e",
    "name": "Billing Service",
    "description": "REST APIs for Stripe customer payment methods, subscription plans, expert payouts/earnings, and billing transactions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "id": "57225879-11111111-0000-4000-8000-000000000001",
      "name": "Payment Methods (Customer)",
      "item": [
        {
          "id": "57225879-11111111-0000-4000-8000-000000000002",
          "name": "List Payment Methods",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/billing/payment-methods",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "payment-methods"
              ]
            },
            "description": "List all saved payment methods of the customer."
          }
        },
        {
          "id": "57225879-11111111-0000-4000-8000-000000000003",
          "name": "Add Payment Method",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethodId\": \"pm_card_visa\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/billing/payment-methods",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "payment-methods"
              ]
            },
            "description": "Associate a new Stripe payment method with the customer."
          }
        },
        {
          "id": "57225879-11111111-0000-4000-8000-000000000004",
          "name": "Remove Payment Method",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/billing/payment-methods/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "payment-methods",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "pm-uuid-here"
                }
              ]
            },
            "description": "Delete a customer's saved payment method."
          }
        }
      ]
    },
    {
      "id": "57225879-22222222-0000-4000-8000-000000000001",
      "name": "Payments & Transactions",
      "item": [
        {
          "id": "57225879-22222222-0000-4000-8000-000000000002",
          "name": "Pre-Authorize Consultation Funds Hold",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethodId\": \"pm-uuid-here\",\n  \"estimatedCents\": 5000\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/billing/consultations/:id/hold",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "consultations",
                ":id",
                "hold"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "consultation-uuid-here"
                }
              ]
            },
            "description": "Pre-authorizes (holds) funds on customer card before starting video call."
          }
        },
        {
          "id": "57225879-22222222-0000-4000-8000-000000000003",
          "name": "Pay Consultation Call",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethodId\": \"pm_card_visa\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/billing/consultations/:id/pay",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "consultations",
                ":id",
                "pay"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "consultation-uuid-here"
                }
              ]
            },
            "description": "Process Stripe charge payment for a completed consultation call."
          }
        },
        {
          "id": "57225879-22222222-0000-4000-8000-000000000004",
          "name": "Get Transaction Receipt Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/billing/transactions/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "transactions",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "transaction-uuid-here"
                }
              ]
            },
            "description": "Get Stripe receipt details of a financial transaction."
          }
        }
      ]
    },
    {
      "id": "57225879-33333333-0000-4000-8000-000000000001",
      "name": "Stripe Connect & Payouts (Expert)",
      "item": [
        {
          "id": "57225879-33333333-0000-4000-8000-000000000002",
          "name": "Submit Custom Connect KYC",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"dob\": { \"day\": 15, \"month\": 5, \"year\": 1988 },\n  \"address\": {\n    \"line1\": \"123 Main St\",\n    \"city\": \"San Francisco\",\n    \"state\": \"CA\",\n    \"postalCode\": \"94105\",\n    \"country\": \"US\"\n  },\n  \"ssnLast4\": \"6789\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/billing/experts/kyc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "experts",
                "kyc"
              ]
            },
            "description": "Create Stripe Custom Connect account natively with Expert KYC details."
          }
        },
        {
          "id": "57225879-33333333-0000-4000-8000-000000000003",
          "name": "Attach Expert Bank Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"routingNumber\": \"110000000\",\n  \"accountNumber\": \"000123456789\",\n  \"accountHolderName\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/billing/experts/bank-account",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "experts",
                "bank-account"
              ]
            },
            "description": "Link bank account to Expert Custom Connect account for payouts."
          }
        }
      ]
    },
    {
      "id": "57225879-44444444-0000-4000-8000-000000000001",
      "name": "Stripe Webhook",
      "item": [
        {
          "id": "57225879-44444444-0000-4000-8000-000000000002",
          "name": "Stripe Webhook Event Listener",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "stripe-signature",
                "value": "t=12345,v1=signature_hash"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"payment_intent.amount_capturable_updated\",\n  \"data\": {}\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/billing/webhook",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "webhook"
              ]
            },
            "description": "Stripe Webhook endpoint for processing async payment & account events."
          }
        }
      ]
    },
    {
      "id": "57225879-55555555-0000-4000-8000-000000000001",
      "name": "Subscriptions (Expert)",
      "item": [
        {
          "id": "57225879-55555555-0000-4000-8000-000000000002",
          "name": "List Subscription Plans",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/billing/subscriptions/plans",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "subscriptions",
                "plans"
              ]
            },
            "description": "List subscription plans available for experts."
          }
        },
        {
          "id": "57225879-55555555-0000-4000-8000-000000000003",
          "name": "Subscribe to Plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"premium_plan_id\",\n  \"paymentMethodId\": \"pm_card_visa\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/billing/subscriptions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "subscriptions"
              ]
            },
            "description": "Subscribe the expert to a membership plan."
          }
        },
        {
          "id": "57225879-55555555-0000-4000-8000-000000000004",
          "name": "Get My Subscription",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/billing/subscriptions/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "subscriptions",
                "me"
              ]
            },
            "description": "Retrieve current plan info and active subscription state of the expert."
          }
        },
        {
          "id": "57225879-55555555-0000-4000-8000-000000000005",
          "name": "Upgrade / Downgrade Plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"planCode\": \"elite\",\n  \"store\": \"apple\",\n  \"receiptData\": \"receipt_upgrade_token\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/billing/subscriptions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "subscriptions"
              ]
            },
            "description": "Upgrade or downgrade to a different plan. Cancels current active subscription and activates the new plan immediately. Will return 409 ALREADY_SUBSCRIBED if same plan is requested."
          }
        },
        {
          "id": "57225879-55555555-0000-4000-8000-000000000006",
          "name": "Cancel Subscription",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/billing/subscriptions/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "subscriptions",
                "me"
              ]
            },
            "description": "Cancels the expert's active subscription immediately. Sets status to 'cancelled'. Returns 404 if no active subscription exists."
          }
        }
      ]
    },

    {
      "id": "57225879-66666666-0000-4000-8000-000000000001",
      "name": "Earnings (Expert)",
      "item": [
