{
  "name": "xpertlink-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "workspaces": [
    "services/*",
    "shared"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./services/**\" run dev",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "env:check": "node scripts/env-check.js",
    "seed": "node scripts/seed.js",
    "reset": "node scripts/reset.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset.js",
    "db:generate": "pnpm --filter @xprtlink/shared run db:generate",
    "db:migrate": "pnpm --filter @xprtlink/shared run db:migrate",
    "db:migrate:dev": "pnpm --filter @xprtlink/shared run db:migrate:dev",
    "db:studio": "pnpm --filter @xprtlink/shared run db:studio"
  },
  "dependencies": {
    "@xprtlink/shared": "workspace:*",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "nodemon": "^3.1.9",
    "pm2": "^5.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
