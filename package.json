{
  "name": "xpertlink-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "workspaces": [
    "services/*",
    "shared"
  ],
  "scripts": {
    "dev": "node scripts/kill-ports.js --pm2 && pnpm -r --parallel --filter \"./services/**\" run dev",
    "dev:stop": "node scripts/kill-ports.js --pm2",
    "ports:kill": "node scripts/kill-ports.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "env:check": "node scripts/env-check.js",
    "seed": "node scripts/seed.js",
    "reset": "node scripts/reset.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset.js",
    "db:generate": "dotenv -e .env -- pnpm --filter @xprtlink/shared run db:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @xprtlink/shared run db:migrate",
    "db:migrate:dev": "dotenv -e .env -- pnpm --filter @xprtlink/shared run db:migrate:dev",
    "db:studio": "dotenv -e .env -- pnpm --filter @xprtlink/shared run db:studio"
  },
  "dependencies": {
    "@xprtlink/shared": "workspace:*",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "dotenv-cli": "^8.0.0",
    "nodemon": "^3.1.14",
    "pm2": "^5.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
