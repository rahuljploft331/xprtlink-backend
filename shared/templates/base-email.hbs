<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <title>XprtLink</title>
  <!--[if mso]>
  <style>
    * {font-family: sans-serif !important;}
  </style>
  <![endif]-->
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    /* Email client resets */
    html, body { margin: 0 auto !important; padding: 0 !important; height: 100% !important; width: 100% !important; background-color: #071a24; }
    * { -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%; }
    div[style*="margin: 16px 0"] { margin: 0 !important; }
    table, td { mso-table-lspace: 0pt !important; mso-table-rspace: 0pt !important; }
    table { border-spacing: 0 !important; border-collapse: collapse !important; table-layout: fixed !important; margin: 0 auto !important; }
    
    body, table, td, p, a, li, blockquote { font-family: 'Outfit', Arial, sans-serif; }
    
    /* Button Hover */
    .button-td, .button-a { transition: all 100ms ease-in; }
    .button-td-primary:hover, .button-a-primary:hover { background: #27836d !important; border-color: #27836d !important; }
    
    /* Mobile responsive */
    @media screen and (max-width: 600px) {
      .email-container { width: 100% !important; margin: auto !important; }
      .fluid { max-width: 100% !important; height: auto !important; margin-left: auto !important; margin-right: auto !important; }
      .stack-column, .stack-column-center { display: block !important; width: 100% !important; max-width: 100% !important; direction: ltr !important; }
      .stack-column-center { text-align: center !important; }
      .main-card { padding: 30px 20px !important; }
      h1 { font-size: 32px !important; }
      h2 { font-size: 24px !important; }
    }
  </style>
</head>
<body width="100%" style="margin: 0; padding: 0 !important; mso-line-height-rule: exactly; background-color: #071a24;">
  <center style="width: 100%; background-color: #071a24;">
    <!--[if mso | IE]>
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #071a24;">
    <tr>
    <td>
    <![endif]-->

    <!-- Background Gradient Container -->
    <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: auto; background: #071a24; background-image: linear-gradient(180deg, #0b2534 0%, #071a24 50%, #031018 100%);">
      <tr>
        <td align="center">
          
          <!-- Email Container -->
          <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="margin: auto;" class="email-container">
            
            <!-- Top Spacing -->
            <tr><td height="50" style="font-size: 50px; line-height: 50px;">&nbsp;</td></tr>

            <!-- Header : BEGIN -->
            <tr>
              <td style="padding: 20px 0; text-align: center">
                <h1 style="margin: 0; font-family: 'Outfit', Arial, sans-serif; font-size: 38px; font-weight: 800; color: #f6fbff; letter-spacing: 0.02em;">Xprt<span style="color: #32b091;">Link</span></h1>
              </td>
            </tr>
            <!-- Header : END -->

            <!-- Spacer -->
            <tr><td height="30" style="font-size: 30px; line-height: 30px;">&nbsp;</td></tr>

            <!-- Main Card : BEGIN -->
            <tr>
              <td class="main-card" style="padding: 40px; background-color: #0d2836; border: 1px solid rgba(255,255,255,0.08); border-radius: 24px; text-align: center; box-shadow: 0 16px 34px rgba(0,0,0,0.14);">
                
                <!-- Badge -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin: auto; margin-bottom: 24px; display: {{SHOW_BADGE}};">
                  <tr>
                    <td style="border-radius: 999px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.14); padding: 10px 18px; text-align: center;">
                      <p style="margin: 0; font-family: 'Outfit', Arial, sans-serif; font-size: 11px; font-weight: 600; color: #f6fbff; letter-spacing: 0.18em; text-transform: uppercase;">
                        <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background-color:#f3bf62; margin-right:10px;"></span>
                        {{BADGE_TEXT}}
                      </p>
                    </td>
                  </tr>
                </table>

                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                  <tr>
                    <td style="padding: 0 0 20px 0; font-family: 'Outfit', Arial, sans-serif; font-size: 28px; line-height: 1.2; font-weight: 700; color: #f6fbff; text-align: center;">
                      {{TITLE}}
                    </td>
                  </tr>
                  <tr>
                    <td style="font-family: 'Outfit', Arial, sans-serif; font-size: 16px; line-height: 1.7; font-weight: 300; color: #b9cbd4; text-align: center;">
                      {{BODY_HTML}}
                    </td>
                  </tr>
                  
                  <!-- CTA Button -->
                  <tr>
                    <td style="padding: 35px 0 10px 0; display: {{SHOW_CTA}};">
                      <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: auto;">
                        <tr>
                          <td class="button-td button-td-primary" style="border-radius: 12px; background: #32b091;">
                            <a class="button-a button-a-primary" href="{{CTA_URL}}" style="background: #32b091; border: 1px solid #32b091; font-family: 'Outfit', Arial, sans-serif; font-size: 16px; text-decoration: none; padding: 16px 28px; color: #ffffff; display: block; border-radius: 12px; font-weight: 500;">{{CTA_TEXT}}</a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                  
                </table>
              </td>
            </tr>
            <!-- Main Card : END -->

            <!-- Bottom Note -->
            <tr>
              <td style="padding: 30px 20px 0 20px; font-family: 'Outfit', Arial, sans-serif; font-size: 13px; line-height: 1.5; color: #b9cbd4; text-align: center; font-weight: 300; display: {{SHOW_BOTTOM_NOTE}};">
                {{BOTTOM_NOTE_HTML}}
              </td>
            </tr>

            <!-- Footer : BEGIN -->
            <tr>
              <td style="padding: 40px 20px; font-family: 'Outfit', Arial, sans-serif; font-size: 13px; line-height: 1.5; color: #6a8291; text-align: center; font-weight: 400;">
                <p style="margin: 0 0 10px 0; color: #e7e7e7;">© 2026 XprtLink • Link. Learn. Solve.</p>
                <p style="margin: 0;">If you didn't request this email, you can safely ignore it.</p>
              </td>
            </tr>
            <!-- Footer : END -->

            <!-- Bottom Spacing -->
            <tr><td height="30" style="font-size: 30px; line-height: 30px;">&nbsp;</td></tr>

          </table>
        </td>
      </tr>
    </table>
    
    <!--[if mso | IE]>
    </td>
    </tr>
    </table>
    <![endif]-->
  </center>
</body>
</html>
