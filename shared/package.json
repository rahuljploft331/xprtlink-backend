{
  "name": "@xprtlink/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./config/*": "./config/*",
    "./middleware/*": "./middleware/*",
    "./utils/*": "./utils/*",
    "./constants/*": "./constants/*",
    "./db": "./db/index.js",
    "./db/*": "./db/*",
    "./contracts": "./contracts/index.js",
    "./contracts/*": "./contracts/*",
    "./mappers": "./mappers/index.js",
    "./mappers/*": "./mappers/*"
  },
  "scripts": {
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  }
}
