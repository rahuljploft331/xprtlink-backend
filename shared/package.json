{
  "name": "@xprtlink/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./config/*": "./config/*",
    "./middleware/*": "./middleware/*",
    "./utils/*": "./utils/*",
    "./constants/*": "./constants/*",
    "./auth/*": "./auth/*",
    "./db": "./db/index.js",
    "./db/*": "./db/*",
    "./contracts": "./contracts/index.js",
    "./contracts/*": "./contracts/*",
    "./mappers": "./mappers/index.js",
    "./mappers/*": "./mappers/*",
    "./lib/*": "./lib/*"
  },
  "scripts": {
    "db:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "npx prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:migrate:dev": "npx prisma migrate dev --schema=./prisma/schema.prisma",
    "db:studio": "npx prisma studio --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@sendgrid/mail": "^8.1.5",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "stripe": "^17.7.0",
    "twilio": "^5.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  }
}
