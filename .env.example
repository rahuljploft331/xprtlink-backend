# XprtLink Backend — local env template
# Copy to .env and fill values. Do not commit .env.
# Later: load the same keys from AWS Secrets Manager via shared/config/secrets.js

NODE_ENV=development
LOG_LEVEL=info
# Comma-separated list of allowed origins. Use * to allow all (dev only).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174

JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
MISSING_PARTICIPANT_TIMEOUT_MINS=5
SERVICE_SECRET=change-me-service-secret

# Rate Limiting (window in ms and max allowed requests)
# Dev: use high values to avoid blocking init:flows / test runs.
# Production: use strict values (AUTH_MAX=10, OTP_MAX=5, PASSWORD_MAX=5).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=200
RATE_LIMIT_OTP_WINDOW_MS=3600000
RATE_LIMIT_OTP_MAX=100
RATE_LIMIT_PASSWORD_WINDOW_MS=900000
RATE_LIMIT_PASSWORD_MAX=50

# Ports (defaults match ecosystem.config.cjs)
API_GATEWAY_PORT=4000
USER_SERVICE_PORT=4001
EXPERT_SERVICE_PORT=4002
CATALOG_SERVICE_PORT=4003
ENGAGEMENT_SERVICE_PORT=4004
MESSAGING_SERVICE_PORT=4005
BILLING_SERVICE_PORT=4006
NOTIFICATION_SERVICE_PORT=4007
MEDIA_SERVICE_PORT=4008
ADMIN_SERVICE_PORT=4009

USER_SERVICE_URL=http://localhost:4001
EXPERT_SERVICE_URL=http://localhost:4002
CATALOG_SERVICE_URL=http://localhost:4003
ENGAGEMENT_SERVICE_URL=http://localhost:4004
MESSAGING_SERVICE_URL=http://localhost:4005
BILLING_SERVICE_URL=http://localhost:4006
NOTIFICATION_SERVICE_URL=http://localhost:4007
MEDIA_SERVICE_URL=http://localhost:4008
# Base URL for public media resolution (S3)
MEDIA_PUBLIC_BASE_URL=https://xprtlink-static.s3.us-west-2.amazonaws.com
ADMIN_SERVICE_URL=http://localhost:4009

# PostgreSQL — single shared database; each service opens its own pool
DATABASE_URL=postgresql://xpertlink:xpertlink@127.0.0.1:5432/xpertlink?schema=public



# ─── Chat Attachment Limits & Allowed Formats ──────────────────────────────
# 1. Images (Formats & Max Size in MB)
CHAT_ATTACHMENT_IMAGE_MIMES=image/jpeg,image/png,image/webp,image/gif,image/heic
CHAT_ATTACHMENT_IMAGE_MAX_SIZE_MB=10

# 2. Documents (Formats & Max Size in MB)
CHAT_ATTACHMENT_DOC_MIMES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,text/csv
CHAT_ATTACHMENT_DOC_MAX_SIZE_MB=15

# 3. Videos (Formats & Max Size in MB)
CHAT_ATTACHMENT_VIDEO_MIMES=video/mp4,video/quicktime,video/webm,video/x-matroska,video/3gpp
CHAT_ATTACHMENT_VIDEO_MAX_SIZE_MB=50

# Integrations (placeholders)
# AWS_REGION=
# AWS_SECRETS_MANAGER_SECRET_ID=
# ─── Stripe Integration ───────────────────────────────────────────────────
# REQUIRED for payment endpoints to function. Without STRIPE_SECRET_KEY,
# all payment routes will return HTTP 503.
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ─── ZegoCloud Video Consultation ─────────────────────────────────────────────
# Get credentials from https://console.zegocloud.com/ → Project → Basic Information
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
# CallbackSecret for webhook signature verification (Project → Callback Setup)
ZEGO_CALLBACK_SECRET=
# FCM_SERVER_KEY=
# S3_BUCKET=

# ─── Firebase (Google / Apple social auth) ───────────────────────────────────
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
# SOCIAL_COMPLETION_TOKEN_EXPIRES_IN=15m

# ─── AWS Secrets Manager integration ────────────────────────────────────────
# Real AWS Authentication (leave blank if using LocalStack or AWS IAM Roles in EC2/ECS)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Region where the secret lives (default "us-west-2")
AWS_SECRETS_MANAGER_REGION=us-west-2
# Name of the secret that contains a JSON object with all keys
AWS_SECRETS_MANAGER_NAME=xpertlink/backend
# Optional endpoint for local mock (e.g., LocalStack). Leave empty for real AWS.
# AWS_SECRETS_MANAGER_ENDPOINT=http://localhost:4566

# ─── OTP delivery ────────────────────────────────────────────────────────────
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=VA1234567890abcdef
# OTP_TTL_MS=600000
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_BLOCK_DURATION_SECONDS=900

# ─── Dev-only OTP hardcode ──────────────────────────────────────────────────
# When OTP_ENABLE_HARDCODE=true every generated OTP is always OTP_HARDCODE_CODE.
# Makes Postman / manual testing trivial — no need to read pm2 logs for codes.
# NEVER set OTP_ENABLE_HARDCODE=true in staging or production.
# OTP_HARDCODE_CODE=123456
# OTP_ENABLE_HARDCODE=false

