# XprtLink Backend — local env template
# Copy to .env and fill values. Do not commit .env.
# Later: load the same keys from AWS Secrets Manager via shared/config/secrets.js

NODE_ENV=development
LOG_LEVEL=info
# Comma-separated list of allowed origins. Use * to allow all (dev only).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174

JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=7d
SERVICE_SECRET=change-me-service-secret

# Rate Limiting (window in ms and max allowed requests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# Ports (defaults match ecosystem.config.cjs)
API_GATEWAY_PORT=4000
USER_SERVICE_PORT=4001
EXPERT_SERVICE_PORT=4002
CATALOG_SERVICE_PORT=4003
ENGAGEMENT_SERVICE_PORT=4004
MESSAGING_SERVICE_PORT=4005
BILLING_SERVICE_PORT=4006
NOTIFICATION_SERVICE_PORT=4007
MEDIA_SERVICE_PORT=4008
ADMIN_SERVICE_PORT=4009

USER_SERVICE_URL=http://localhost:4001
EXPERT_SERVICE_URL=http://localhost:4002
CATALOG_SERVICE_URL=http://localhost:4003
ENGAGEMENT_SERVICE_URL=http://localhost:4004
MESSAGING_SERVICE_URL=http://localhost:4005
BILLING_SERVICE_URL=http://localhost:4006
NOTIFICATION_SERVICE_URL=http://localhost:4007
MEDIA_SERVICE_URL=http://localhost:4008
ADMIN_SERVICE_URL=http://localhost:4009

# PostgreSQL — single shared database; each service opens its own pool
DATABASE_URL=postgresql://xpertlink:xpertlink@127.0.0.1:5432/xpertlink?schema=public

# Optional: public base URL for seeded media metadata
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com

# Integrations (placeholders)
# AWS_REGION=
# AWS_SECRETS_MANAGER_SECRET_ID=
# STRIPE_SECRET_KEY=
# ZEGO_APP_ID=
# FCM_SERVER_KEY=
# S3_BUCKET=

# ─── Dev-only OTP hardcode ──────────────────────────────────────────────────
# When OTP_ENABLE_HARDCODE=true every generated OTP is always OTP_HARDCODE_CODE.
# Makes Postman / manual testing trivial — no need to read pm2 logs for codes.
# NEVER set OTP_ENABLE_HARDCODE=true in staging or production.
# OTP_HARDCODE_CODE=123456
# OTP_ENABLE_HARDCODE=false

