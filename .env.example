# XprtLink Backend — local env template
# Copy to .env and fill values. Do not commit .env.
# Later: load the same keys from AWS Secrets Manager via shared/config/secrets.js

NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# Auth / internal (required when auth is implemented)
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=7d
SERVICE_SECRET=change-me-service-secret

# Service ports (defaults match ecosystem.config.cjs)
API_GATEWAY_PORT=4000
USER_SERVICE_PORT=4001
CATALOG_SERVICE_PORT=4002
SEARCH_SERVICE_PORT=4003
QUOTE_SERVICE_PORT=4004
MESSAGING_SERVICE_PORT=4005
CONSULTATION_SERVICE_PORT=4006
PAYMENT_SERVICE_PORT=4007
SUBSCRIPTION_SERVICE_PORT=4008
NOTIFICATION_SERVICE_PORT=4009
MEDIA_SERVICE_PORT=4010
ADMIN_SERVICE_PORT=4011
REPORTING_SERVICE_PORT=4012

# Service URLs (gateway + internal HTTP)
USER_SERVICE_URL=http://localhost:4001
CATALOG_SERVICE_URL=http://localhost:4002
SEARCH_SERVICE_URL=http://localhost:4003
QUOTE_SERVICE_URL=http://localhost:4004
MESSAGING_SERVICE_URL=http://localhost:4005
CONSULTATION_SERVICE_URL=http://localhost:4006
PAYMENT_SERVICE_URL=http://localhost:4007
SUBSCRIPTION_SERVICE_URL=http://localhost:4008
NOTIFICATION_SERVICE_URL=http://localhost:4009
MEDIA_SERVICE_URL=http://localhost:4010
ADMIN_SERVICE_URL=http://localhost:4011
REPORTING_SERVICE_URL=http://localhost:4012

# Deferred — do not wire until DB decision is made
# MONGODB_URI=
# REDIS_URL=redis://localhost:6379

# Integrations (placeholders)
# AWS_REGION=
# AWS_SECRETS_MANAGER_SECRET_ID=
# STRIPE_SECRET_KEY=
# ZEGO_APP_ID=
# FCM_SERVER_KEY=
# S3_BUCKET=
